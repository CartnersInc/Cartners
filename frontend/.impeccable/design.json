  "narrative": {
    "northStar": "The Shared Kitchen Cookbook",
    "overview": "A contemporary illustrated cookbook translated into a working household app. Warm paper, expressive headings, original ingredient sketches and saturated color fields carry the collaborative cooking energy requested for DubHacks 2026 and the Cook Smarter track. The lowercase cartners wordmark remains the product identity; no sponsor marks or affiliation are implied.\n\nThe task area stays readable and direct. Color distinguishes actions and supporting surfaces, while dense shopping and ingredient content remains in rows. Decorative motion is brief; frequently used controls respond immediately.",
    "keyCharacteristics": [
      "Warm paper and aubergine ink.",
      "Cobalt actions, tomato display accents, butter and lilac fields.",
      "Expressive cookbook headings with clear everyday controls.",
      "Ingredient illustration alongside real recipe photography."
    ],
    "rules": [
      {
        "name": "The Cobalt Action Rule",
        "body": "Cobalt identifies primary actions and focus; tomato supplies display emphasis rather than coloring every button.",
        "section": "colors"
      },
      {
        "name": "The Shared Table Rule",
        "body": "Use broad tonal fields to organize work; preserve compact rows for dense task content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use cobalt for the primary action and visible keyboard focus.",
      "Do retain ingredient sketches as decorative art with empty alternative text.",
      "Do keep shopping and ingredient information readable as rows.",
      "Do preserve reduced-motion behavior and the recipe carousel\u2019s pause control.",
      "Do keep navigation, review, confirmation and recovery controls available at every viewport."
    ],
    "donts": [
      "Don't return to the muted green identity.",
      "Don't replace recipe photography with decorative ingredient art.",
      "Don't imply official DubHacks sponsorship or affiliation.",
      "Don't introduce gradients as the new surface language.",
      "Don't hide essential actions behind decorative motion."
    ]
  }
