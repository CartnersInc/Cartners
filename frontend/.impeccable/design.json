  "narrative": {
    "northStar": "The Playful Shared Kitchen",
    "overview": "Cartners brings the warmth and playful kitchen-object language of the user-pinned [DubHacks 2026 reference](https://dh26.dubhacks.co/) into a practical household app. Cream paper, cocoa text, warm blue actions and flat original cooking illustrations establish the replacement world. The user rejected the earlier purple/yellow palette and engraved ingredient treatment; those are not the visual authority for future work. Cartners retains its lowercase wordmark and does not imply event sponsorship or affiliation.\n\nThe Cook Smarter direction centers on less coordination work: AI helps turn a request into a reviewed list, while spatial feedback makes changes understandable. Motion follows the user\u2019s work through navigation, setup, drafting, list updates and disclosures. Dense task information stays in readable rows.",
    "keyCharacteristics": [
      "Warm cream and cocoa with restrained warm blue actions.",
      "Parchment and apron fields with paprika display accents.",
      "Flat, playful original kitchen objects alongside real recipe photography.",
      "State-preserving surfaces, visible progress and immediate control feedback."
    ],
    "rules": [
      {
        "name": "The Blue Action Rule",
        "body": "Warm blue identifies primary actions and focus; paprika adds display emphasis without coloring every button.",
        "section": "colors"
      },
      {
        "name": "The Shared Table Rule",
        "body": "Use broad tonal fields to organize work; preserve compact rows for dense task content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use warm blue for the primary action and visible keyboard focus.",
      "Do retain flat kitchen-object artwork as decorative art with empty alternative text.",
      "Do keep shopping and ingredient information readable as rows.",
      "Do preserve reduced-motion behavior and the recipe carousel\u2019s pause control.",
      "Do keep navigation, review, confirmation and recovery controls available at every viewport."
    ],
    "donts": [
      "Don't return to the rejected purple/yellow palette or engraved ingredient treatment.",
      "Don't replace recipe photography with decorative kitchen art.",
      "Don't imply official DubHacks sponsorship or affiliation.",
      "Don't introduce gradients as the new surface language.",
      "Don't hide essential actions behind decorative motion."
    ]
  }
}
