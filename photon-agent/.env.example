# Create a Photon 2.0 beta project and a server-side key with project:read + project:write.
PHOTON_PROJECT_ID=pho_prj_REPLACE_ME
PHOTON_API_KEY=REPLACE_ME
PHOTON_PLATFORM=imessage
PHOTON_AGENT_HANDLE=REPLACE_WITH_ASSIGNED_AGENT_HANDLE

# Comma-separated iMessage handles permitted to ask Cartners to change the shared cart.
PHOTON_ALLOWED_SENDERS=+15550000001,+15550000002

# Map each allowed Photon sender to a seeded Cartners actor ID.
CARTNERS_ACTOR_BY_SENDER={"+15550000001":"sam","+15550000002":"lee"}
CARTNERS_WORKSPACE_ID=demo-family
CARTNERS_API_URL=http://127.0.0.1:8000
PHOTON_STATE_FILE=.runtime/state.json
PHOTON_POLL_MS=2000
