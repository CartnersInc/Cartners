# Spectrum Cloud (stable). Minted by Photon CLI; never commit the real secret.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# iMessage handles allowed to change the shared Cartners cart (E.164).
# Include dad and each roommate who will text the household line.
PHOTON_ALLOWED_SENDERS=+15550000001,+15550000002

# Map each allowed sender to a Cartners actor ID in CARTNERS_WORKSPACE_ID.
CARTNERS_ACTOR_BY_SENDER={"+15550000001":"sam","+15550000002":"lee"}
CARTNERS_WORKSPACE_ID=demo-family
CARTNERS_API_URL=http://127.0.0.1:8000
# Required for a private household. Leave empty for demo-family / demo-roommates.
CARTNERS_SESSION_TOKEN=
# family | roommates — changes the help copy. Defaults from the workspace id.
CARTNERS_HOUSEHOLD_KIND=family
PHOTON_STATE_FILE=.runtime/state.json

# Optional Photon 2.0 beta poller (`npm run start:beta`) only.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_PLATFORM=imessage
PHOTON_AGENT_HANDLE=
